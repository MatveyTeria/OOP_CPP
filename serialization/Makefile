# =============================================================================
# Makefile for the serialization project.
#
# Usage:
#   make          -- build the test binary
#   make test     -- build and run all tests
#   make clean    -- remove build artefacts
#
# Requirements:
#   - g++ with C++17 support
#   - libgtest-dev (or gtest built from source, see the "gtest-from-source"
#     target below)
#
# On Debian/Ubuntu:
#   sudo apt install build-essential libgtest-dev
# =============================================================================

export TMPDIR := $(CURDIR)/tmp
export TMP    := $(CURDIR)/tmp
export TEMP   := $(CURDIR)/tmp


# ---- Toolchain -------------------------------------------------------------
CXX      ?= g++
CXXFLAGS ?= -std=c++17 -Wall -Wextra -Wpedantic -Werror -O2 -g
CPPFLAGS ?= -Iinclude -Itests
LDFLAGS  ?=
LDLIBS   ?= -lgtest -lgtest_main -pthread

# ---- Paths -----------------------------------------------------------------
BUILD_DIR := build

TEST_SRC  := tests/test_serialize.cpp
TEST_OBJ  := $(BUILD_DIR)/test_serialize.o
TEST_BIN  := $(BUILD_DIR)/test_serialize
TEST_DEP  := $(TEST_OBJ:.o=.d)

# Any change to any header forces recompilation of the test.
# (Recomputed every run, so adding a new header "just works".)
HDRS := $(wildcard include/serialize/*.h)

# ---- Phony targets ---------------------------------------------------------
.PHONY: all test run clean

all: $(TEST_BIN)

test run: $(TEST_BIN)
	./$(TEST_BIN)

# ---- Real rules ------------------------------------------------------------
$(BUILD_DIR):
	@mkdir -p $@

# -MMD -MP: generate a .d file with the header dependencies of this TU.
# We then "-include" it below -- that's how make learns that test_serialize.o
# depends on, say, include/serialize/vector.h.
$(TEST_OBJ): $(TEST_SRC) $(HDRS) | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(TEST_BIN): $(TEST_OBJ)
	$(CXX) $(LDFLAGS) $^ $(LDLIBS) -o $@

clean:
	rm -rf $(BUILD_DIR)

# Pull in the header-dependency files generated by -MMD. The leading "-"
# tells make to ignore them if they don't exist yet (first build).
-include $(TEST_DEP)